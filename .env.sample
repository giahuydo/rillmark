# Copy to .env for local runs. Exported environment variables take precedence.

# OpenAI project key (required except for --dry-run). OPENAI_API_KEY is also accepted.
API_KEY=

# Optional: pin a store; it must carry metadata managed_by=rillmark-optibot-v1.
# Leave empty to find (or create) the marked store in the key's project.
VECTOR_STORE_ID=

# Optional overrides of config/selection.json
# SECTION_IDS=26324076807315,26324141467539,26324224269459
# YOUTUBE_ARTICLE_ID=360051014713

# Optional static chunking (defaults: 4096 / 0)
# MAX_CHUNK_SIZE_TOKENS=4096
# CHUNK_OVERLAP_TOKENS=0

# Public run artifact (scheduled runs only): gist ID and a gist-scope token
ARTIFACT_GIST_ID=
ARTIFACT_GITHUB_TOKEN=
